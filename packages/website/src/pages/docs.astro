---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>Documentation - waytrans</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body class="m-0 bg-white text-gray-900 font-medium overflow-x-hidden docs-page">
    <div class="bg-grid-pattern min-h-screen">
      <Header />
      
      <div class="flex w-full md:max-w-7xl md:mx-auto relative">
        <!-- Mobile sidebar toggle button - positioned absolutely below navbar -->
        <button 
          id="mobile-sidebar-toggle" 
          class="fixed top-20 left-4 z-40 md:hidden px-3 py-2 border-2 border-black rounded-lg bg-blue-500 text-white font-bold text-sm shadow-brutalist transition-opacity duration-300"
        >
          📚 Menu
        </button>

        <!-- Sidebar - absolutely positioned to overlay content -->
        <nav 
          id="sidebar" 
          class="w-64 lg:w-80 bg-white border-r-2 border-black flex-shrink-0 
                 hidden md:block fixed z-30 md:z-auto 
                 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out
                 flex flex-col
                 left-0 top-0 bottom-0
                 h-screen"
        >
          <!-- Fixed header section -->
          <div class="p-4 lg:p-6 pt-20 md:pt-4 lg:md:pt-6 border-b-2 border-black flex-shrink-0">
            <!-- Close button for mobile -->
            <button 
              id="sidebar-close" 
              class="md:hidden w-full mb-4 px-3 py-2 border-2 border-black rounded-lg bg-blue-500 text-white font-bold text-sm shadow-brutalist"
            >
              ✕ Close Menu
            </button>
            
            <!-- Search -->
            <input 
              type="text" 
              id="search-input"
              placeholder="Search docs..."
              class="w-full px-4 py-2 border-2 border-black rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>

          <!-- Scrollable navigation content -->
          <div class="flex-1 overflow-y-auto p-4 lg:p-6 scrollbar-thin">
            <!-- Navigation Sections -->
            <div class="space-y-4">
            <div>
              <h3 class="font-bold text-sm uppercase tracking-widest mb-3 text-gray-600">Getting Started</h3>
              <ul class="space-y-2">
                <li><a href="#installation" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="installation">Installation</a></li>
                <li><a href="#quick-start" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="quick-start">Quick Start</a></li>
                <li><a href="#requirements" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="requirements">Requirements</a></li>
              </ul>
            </div>

            <div>
              <h3 class="font-bold text-sm uppercase tracking-widest mb-3 text-gray-600">Configuration</h3>
              <ul class="space-y-2">
                <li><a href="#keybindings" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="keybindings">Keybindings</a></li>
                <li><a href="#hyprland" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="hyprland">Hyprland</a></li>
                <li><a href="#sway" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="sway">Sway</a></li>
                <li><a href="#river" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="river">River</a></li>
              </ul>
            </div>

            <div>
              <h3 class="font-bold text-sm uppercase tracking-widest mb-3 text-gray-600">Usage</h3>
              <ul class="space-y-2">
                <li><a href="#cli-flags" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="cli-flags">CLI Flags</a></li>
                <li><a href="#live-mode" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="live-mode">Live Mode</a></li>
                <li><a href="#languages" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="languages">Languages</a></li>
                <li><a href="#ocr-models" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="ocr-models">OCR Models</a></li>
              </ul>
            </div>

            <div>
              <h3 class="font-bold text-sm uppercase tracking-widest mb-3 text-gray-600">Troubleshooting</h3>
              <ul class="space-y-2">
                <li><a href="#common-issues" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="common-issues">Common Issues</a></li>
                <li><a href="#dependencies" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="dependencies">Dependencies</a></li>
                <li><a href="#performance" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="performance">Performance</a></li>
              </ul>
            </div>

            <div>
              <h3 class="font-bold text-sm uppercase tracking-widest mb-3 text-gray-600">Development</h3>
              <ul class="space-y-2">
                <li><a href="#architecture" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="architecture">Architecture</a></li>
                <li><a href="#contributing" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="contributing">Contributing</a></li>
                <li><a href="#api" class="nav-link block py-1 px-2 rounded hover:bg-blue-50 text-sm" data-section="api">API Reference</a></li>
              </ul>
            </div>
          </div>
          </div>
        </nav>

        <!-- Main Content -->
        <main class="flex-1 p-4 lg:p-8 pt-20 md:pt-6 w-full md:w-auto overflow-x-hidden">
          <div class="mb-8">
            <h1 class="text-4xl font-bold tracking-tight uppercase mb-4">Documentation</h1>
            <p class="text-lg text-gray-600">Complete guide to using waytrans for in-place screen translation.</p>
          </div>
          <!-- Installation Section -->
          <section id="installation" class="doc-section mb-12">
            <h2 class="text-2xl font-bold mb-4 border-b-2 border-black pb-2">Installation</h2>
            
            <Card class="mb-6">
              <h3 class="font-bold text-lg mb-3">Quick Install (Recommended)</h3>
              <p class="mb-4">Clone the repository and run the installer:</p>
              <div class="bg-gray-100 border-2 border-black rounded-lg p-4 mb-4 overflow-x-auto">
                <pre class="font-mono text-sm text-black whitespace-pre-wrap"><code>git clone https://github.com/remsysc/waytrans.git
cd waytrans
./install.sh</code></pre>
              </div>
              <p class="text-sm text-gray-600">This installs the binary to <code class="font-mono bg-gray-100 px-1 rounded">~/.local/bin/waytrans</code> and prompts you to download high-accuracy Japanese OCR models.</p>
            </Card>

            <Card>
              <h3 class="font-bold text-lg mb-3">Python / Pip Install</h3>
              <div class="bg-gray-100 border-2 border-black rounded-lg p-4 mb-4 overflow-x-auto">
                <pre class="font-mono text-sm text-black whitespace-pre-wrap"><code>git clone https://github.com/remsysc/waytrans.git
cd waytrans
pip install --user .</code></pre>
              </div>
            </Card>
          </section>

          <!-- Requirements Section -->
          <section id="requirements" class="doc-section mb-12">
            <h2 class="text-2xl font-bold mb-4 border-b-2 border-black pb-2">Requirements & Dependencies</h2>
            
            <p class="mb-4">waytrans relies on standard Linux Wayland and OCR utilities.</p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <Card>
                <h3 class="font-bold text-lg mb-3">Arch Linux / CachyOS / Manjaro</h3>
                <div class="bg-gray-100 border-2 border-black rounded-lg p-4 overflow-x-auto">
                  <pre class="font-mono text-xs text-black whitespace-pre"><code>sudo pacman -S grim slurp tesseract translate-shell \
  wl-clipboard gtk-layer-shell python-gobject</code></pre>
                </div>
              </Card>

              <Card>
                <h3 class="font-bold text-lg mb-3">Fedora / RHEL</h3>
                <div class="bg-gray-100 border-2 border-black rounded-lg p-4 overflow-x-auto">
                  <pre class="font-mono text-xs text-black whitespace-pre"><code>sudo dnf install grim slurp tesseract translate-shell \
  wl-clipboard gtk-layer-shell python3-gobject</code></pre>
                </div>
              </Card>

              <Card>
                <h3 class="font-bold text-lg mb-3">Ubuntu / Debian</h3>
                <div class="bg-gray-100 border-2 border-black rounded-lg p-4 overflow-x-auto">
                  <pre class="font-mono text-xs text-black whitespace-pre"><code>sudo apt install grim slurp tesseract-ocr translate-shell \
  wl-clipboard libgtk-layer-shell0 python3-gi</code></pre>
                </div>
              </Card>

              <Card>
                <h3 class="font-bold text-lg mb-3">Optional</h3>
                <p class="text-sm mb-2"><code class="font-mono bg-gray-100 px-1 rounded">imagemagick</code> for automated 2x contrast pre-processing on low-resolution text.</p>
              </Card>
            </div>
          </section>

          <!-- Quick Start Section -->
          <section id="quick-start" class="doc-section mb-12">
            <h2 class="text-2xl font-bold mb-4 border-b-2 border-black pb-2">Quick Start</h2>
            
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <Card>
                <h3 class="font-bold text-lg mb-3">1. Setup Japanese Models</h3>
                <p class="mb-3">For accurate Japanese character recognition:</p>
                <div class="bg-gray-100 border-2 border-black rounded-lg p-4 mb-3 overflow-x-auto">
                  <pre class="font-mono text-sm text-black whitespace-pre-wrap"><code>waytrans --setup-models</code></pre>
                </div>
                <p class="text-sm text-gray-600">This places <code class="font-mono bg-gray-100 px-1 rounded">jpn.traineddata</code> and <code class="font-mono bg-gray-100 px-1 rounded">jpn_vert.traineddata</code> into <code class="font-mono bg-gray-100 px-1 rounded">~/.local/share/tessdata/</code></p>
              </Card>

              <Card>
                <h3 class="font-bold text-lg mb-3">2. Basic Usage</h3>
                <p class="mb-3">Translate Japanese to English:</p>
                <div class="bg-gray-100 border-2 border-black rounded-lg p-4 mb-3 overflow-x-auto">
                  <pre class="font-mono text-sm text-black whitespace-pre-wrap"><code>waytrans -s ja -t en</code></pre>
                </div>
                <p class="text-sm text-gray-600">Drag a selection box around text, and the translation appears as an overlay.</p>
              </Card>
            </div>
          </section>

          <!-- Keybindings Section -->
          <section id="keybindings" class="doc-section mb-12">
            <h2 class="text-2xl font-bold mb-4 border-b-2 border-black pb-2">Compositor Keybindings</h2>
            
            <p class="mb-6">Add shortcuts to your Wayland compositor configuration:</p>

            <!-- Hyprland -->
            <div id="hyprland" class="mb-8">
              <Card>
                <h3 class="font-bold text-lg mb-3 flex items-center gap-2">
                  <span class="w-6 h-6 bg-blue-500 rounded border border-black"></span>
                  Hyprland
                </h3>
                <p class="mb-3">In <code class="font-mono bg-gray-100 px-1 rounded">~/.config/hypr/hyprland.conf</code>:</p>
                <div class="bg-gray-100 border-2 border-black rounded-lg p-4 mb-3 overflow-x-auto">
                  <pre class="font-mono text-sm text-black whitespace-pre"><code># One-shot screen translation (Super + Alt + J)
bind = SUPER_ALT, J, exec, waytrans -s ja -t en

# Dynamic Live Translation toggle (Super + Alt + L)
bind = SUPER_ALT, L, exec, waytrans --live -s ja -t en</code></pre>
                </div>
                <p class="text-sm text-gray-600">Or if you use Hyprland Lua configurations:</p>
                <div class="bg-gray-100 border-2 border-black rounded-lg p-4 overflow-x-auto">
                  <pre class="font-mono text-sm text-black whitespace-pre"><code>{`hl.bind("SUPER + ALT + J", 
  hl.dsp.exec_cmd("waytrans -s ja -t en"), 
  { description: "Translate screen JP to EN" })
hl.bind("SUPER + ALT + L", 
  hl.dsp.exec_cmd("waytrans --live -s ja -t en"), 
  { description: "Toggle Live Translation" })`}</code></pre>
                </div>
              </Card>
            </div>

            <!-- Sway -->
            <div id="sway" class="mb-8">
              <Card>
                <h3 class="font-bold text-lg mb-3 flex items-center gap-2">
                  <span class="w-6 h-6 bg-green-500 rounded border border-black"></span>
                  Sway
                </h3>
                <p class="mb-3">In <code class="font-mono bg-gray-100 px-1 rounded">~/.config/sway/config</code>:</p>
                <div class="bg-gray-100 border-2 border-black rounded-lg p-4 overflow-x-auto">
                  <pre class="font-mono text-sm text-black whitespace-pre"><code>bindsym $mod+Mod1+j exec waytrans -s ja -t en
bindsym $mod+Mod1+l exec waytrans --live -s ja -t en</code></pre>
                </div>
              </Card>
            </div>

            <!-- River -->
            <div id="river" class="mb-8">
              <Card>
                <h3 class="font-bold text-lg mb-3 flex items-center gap-2">
                  <span class="w-6 h-6 bg-purple-500 rounded border border-black"></span>
                  River
                </h3>
                <p class="mb-3">In <code class="font-mono bg-gray-100 px-1 rounded">~/.config/river/init</code>:</p>
                <div class="bg-gray-100 border-2 border-black rounded-lg p-4 overflow-x-auto">
                  <pre class="font-mono text-sm text-black whitespace-pre"><code>riverctl map normal Super+Alt J spawn "waytrans -s ja -t en"
riverctl map normal Super+Alt L spawn "waytrans --live -s ja -t en"</code></pre>
                </div>
              </Card>
            </div>
          </section>
          <!-- CLI Flags Section -->
          <section id="cli-flags" class="doc-section mb-12">
            <h2 class="text-2xl font-bold mb-4 border-b-2 border-black pb-2">CLI Usage & Flags</h2>
            
            <Card class="mb-6">
              <div class="bg-gray-100 border-2 border-black rounded-lg p-4 mb-4 overflow-x-auto">
                <pre class="font-mono text-sm text-black whitespace-pre"><code>usage: waytrans [-h] [-s SOURCE] [-t TARGET] [--timeout TIMEOUT] 
                [--psm PSM] [--no-overlay] [--no-clipboard] 
                [--notify] [-l] [--interval INTERVAL] 
                [--stop-live] [--setup-models] [-v]</code></pre>
              </div>
            </Card>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <Card>
                <h3 class="font-bold text-lg mb-3">Basic Options</h3>
                <div class="overflow-x-auto">
                  <table class="w-full text-sm min-w-full">
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">-h, --help</td>
                      <td class="py-2">Show help message and exit</td>
                    </tr>
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">-s, --source</td>
                      <td class="py-2">Source language code (default: ja)</td>
                    </tr>
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">-t, --target</td>
                      <td class="py-2">Target language code (default: en)</td>
                    </tr>
                    <tr>
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">-v, --version</td>
                      <td class="py-2">Show version</td>
                    </tr>
                  </table>
                </div>
              </Card>

              <Card>
                <h3 class="font-bold text-lg mb-3">Overlay Options</h3>
                <div class="overflow-x-auto">
                  <table class="w-full text-sm min-w-full">
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">--timeout</td>
                      <td class="py-2">Overlay timeout in seconds (default: 10, 0 = stay until clicked)</td>
                    </tr>
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">--no-overlay</td>
                      <td class="py-2">Disable in-place overlay (desktop notification only)</td>
                    </tr>
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">--no-clipboard</td>
                      <td class="py-2">Disable copying translation to clipboard</td>
                    </tr>
                    <tr>
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">--notify</td>
                      <td class="py-2">Trigger a desktop notification alongside the overlay</td>
                    </tr>
                  </table>
                </div>
              </Card>

              <Card>
                <h3 class="font-bold text-lg mb-3">Live Mode Options</h3>
                <div class="overflow-x-auto">
                  <table class="w-full text-sm min-w-full">
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">-l, --live</td>
                      <td class="py-2">Toggle dynamic live translation mode on or off</td>
                    </tr>
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">--interval</td>
                      <td class="py-2">Polling interval in seconds for live translation (default: 0.5)</td>
                    </tr>
                    <tr>
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">--stop-live</td>
                      <td class="py-2">Stop any currently running live translation session</td>
                    </tr>
                  </table>
                </div>
              </Card>

              <Card>
                <h3 class="font-bold text-lg mb-3">OCR Options</h3>
                <div class="overflow-x-auto">
                  <table class="w-full text-sm min-w-full">
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">--psm</td>
                      <td class="py-2">Tesseract Page Segmentation Mode (default: 6)</td>
                    </tr>
                    <tr>
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">--setup-models</td>
                      <td class="py-2">Download high-accuracy Japanese OCR models</td>
                    </tr>
                  </table>
                </div>
              </Card>
            </div>

            <Card class="mt-6">
              <h3 class="font-bold text-lg mb-3">Example Commands</h3>
              <div class="space-y-4">
                <div>
                  <p class="font-medium mb-2">One-shot translation:</p>
                  <div class="bg-gray-100 border-2 border-black rounded-lg p-3 overflow-x-auto">
                    <code class="font-mono text-sm text-black">waytrans</code>
                  </div>
                </div>
                
                <div>
                  <p class="font-medium mb-2">Toggle Live / Dynamic translation:</p>
                  <div class="bg-gray-100 border-2 border-black rounded-lg p-3 overflow-x-auto">
                    <code class="font-mono text-sm text-black">waytrans -l</code>
                  </div>
                </div>

                <div>
                  <p class="font-medium mb-2">Chinese (Simplified) to English in live mode:</p>
                  <div class="bg-gray-100 border-2 border-black rounded-lg p-3 overflow-x-auto">
                    <code class="font-mono text-sm text-black">waytrans -l -s zh -t en</code>
                  </div>
                </div>

                <div>
                  <p class="font-medium mb-2">German to English with 20-second timeout:</p>
                  <div class="bg-gray-100 border-2 border-black rounded-lg p-3 overflow-x-auto">
                    <code class="font-mono text-sm text-black">waytrans -s de -t en --timeout 20</code>
                  </div>
                </div>

                <div>
                  <p class="font-medium mb-2">Notification-only mode (no overlay):</p>
                  <div class="bg-gray-100 border-2 border-black rounded-lg p-3 overflow-x-auto">
                    <code class="font-mono text-sm text-black">waytrans --no-overlay</code>
                  </div>
                </div>
              </div>
            </Card>
          </section>
          <!-- Live Mode Section -->
          <section id="live-mode" class="doc-section mb-12">
            <h2 class="text-2xl font-bold mb-4 border-b-2 border-black pb-2">Live Translation Mode</h2>
            
            <Card class="mb-6">
              <h3 class="font-bold text-lg mb-3">🔄 Dynamic Live Translation</h3>
              <p class="mb-4">Toggle it on and waytrans continuously watches dialogue boxes or manga panels, detects new incoming text via perceptual hashing, and dynamically updates the translation in-place!</p>
              
              <div class="bg-blue-50 border-2 border-blue-200 rounded-lg p-4 mb-4">
                <h4 class="font-bold mb-2">Features:</h4>
                <ul class="list-disc list-inside space-y-1 text-sm">
                  <li><strong>Click-Through:</strong> Allows full mouse pass-through during live mode</li>
                  <li><strong>Perceptual Hashing:</strong> Detects new text automatically</li>
                  <li><strong>Real-time Updates:</strong> Translation updates without manual intervention</li>
                  <li><strong>Game Compatible:</strong> Click to advance dialogue without interruption</li>
                </ul>
              </div>

              <div class="bg-gray-100 border-2 border-black rounded-lg p-4 overflow-x-auto">
                <pre class="font-mono text-sm text-black whitespace-pre"><code># Start live mode
waytrans --live -s ja -t en

# Stop live mode
waytrans --stop-live

# Custom polling interval (default: 0.5s)
waytrans --live --interval 1.0</code></pre>
              </div>
            </Card>
          </section>

          <!-- Languages Section -->
          <section id="languages" class="doc-section mb-12">
            <h2 class="text-2xl font-bold mb-4 border-b-2 border-black pb-2">Supported Languages</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <Card>
                <h3 class="font-bold text-lg mb-3">Common Language Codes</h3>
                <div class="overflow-x-auto">
                  <table class="w-full text-sm min-w-full">
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">ja</td>
                      <td class="py-2">Japanese</td>
                    </tr>
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">en</td>
                      <td class="py-2">English</td>
                    </tr>
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">zh</td>
                      <td class="py-2">Chinese (Simplified)</td>
                    </tr>
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">ko</td>
                      <td class="py-2">Korean</td>
                    </tr>
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">de</td>
                      <td class="py-2">German</td>
                    </tr>
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">fr</td>
                      <td class="py-2">French</td>
                    </tr>
                    <tr class="border-b border-gray-200">
                      <td class="font-mono font-bold py-2 pr-4 whitespace-nowrap">es</td>
                      <td class="py-2">Spanish</td>
                    </tr>
